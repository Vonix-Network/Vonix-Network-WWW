# ===================================
# VONIX NETWORK - ENVIRONMENT VARIABLES
# ===================================
# Copy this file to .env and fill in your values

# ===================================
# ENVIRONMENT
# ===================================
NODE_ENV=development  # or 'production' for live
NEXT_PUBLIC_APP_URL=http://localhost:3000  # Production: https://vonix.network

# ===================================
# SESSION & AUTHENTICATION
# ===================================
# Generate with: openssl rand -base64 32
SESSION_SECRET=generate-a-long-random-string-here
NEXTAUTH_SECRET=your-secret-key-here

# Auth URL - Primary domain
AUTH_URL=http://localhost:3000  # Production: https://vonix.network

# Trust all hosts (required for multiple domains)
AUTH_TRUST_HOST=true

# ===================================
# DATABASE
# ===================================
# Local SQLite (Development)
DATABASE_URL=file:./data/vonix.db

# OR Turso (Production)
# DATABASE_URL=libsql://vonix-network-prod-[your-org].turso.io
# DATABASE_AUTH_TOKEN=your_turso_auth_token

# ===================================
# CRON & AUTOMATION
# ===================================
# Cron Job Secret (for automated tasks like rank expiration)
# Generate with: openssl rand -base64 32
CRON_SECRET=your-cron-secret-here

# ===================================
# INTEGRATIONS (Optional)
# ===================================
# Discord Bot Integration
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Email Configuration (can also be set via Admin panel)
EMAIL_SERVER=
EMAIL_FROM=

# ===================================
# PAYMENT SYSTEM
# ===================================
# Choose ONE provider: 'stripe' or 'square'
# Leave empty to disable online payments
PAYMENT_PROVIDER=stripe

# ---- STRIPE CONFIGURATION ----
# Development (Test Mode)
# STRIPE_SECRET_KEY=sk_test_your_test_secret_key
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key
# STRIPE_WEBHOOK_SECRET=whsec_your_test_webhook_secret

# Production (Live Mode) - Use these for https://vonix.network
STRIPE_SECRET_KEY=sk_live_your_live_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_live_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_live_webhook_secret

# Subscriptions Feature Flag
# Set to 'false' to disable recurring subscriptions site-wide
# Defaults to 'true' if not set - Safe to deploy without this variable
# Use this to control subscription availability (e.g., during testing or maintenance)
ENABLE_SUBSCRIPTIONS=true

# ---- SQUARE CONFIGURATION (Alternative) ----
# PAYMENT_PROVIDER=square
# SQUARE_ACCESS_TOKEN=
# SQUARE_LOCATION_ID=
# SQUARE_APPLICATION_ID=
# SQUARE_WEBHOOK_SIGNATURE_KEY=
# SQUARE_ENVIRONMENT=sandbox  # or 'production'
