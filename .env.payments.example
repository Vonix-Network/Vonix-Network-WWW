# =============================================================================
# VONIX NETWORK - PAYMENT SYSTEM CONFIGURATION
# =============================================================================
# This file configures payment processing for donation ranks and subscriptions
# Supports: Stripe, Square, or disabled (manual payments only)
# 
# QUICK START:
# 1. Copy this file to .env (or add to your existing .env)
# 2. Choose your payment provider below
# 3. Add your API keys from Stripe or Square dashboard
# 4. Configure webhooks (see instructions below)
# 5. Test with provided test cards
# 
# Documentation: See PAYMENT_SYSTEM_SETUP.md for detailed setup guide
# =============================================================================

# =============================================================================
# PAYMENT PROVIDER SELECTION
# =============================================================================
# Choose ONE payment provider: 'stripe', 'square', or leave empty to disable
# Only one provider can be active at a time
#
# Options:
#   stripe  - Use Stripe for payment processing (recommended)
#   square  - Use Square for payment processing
#   (empty) - Disable online payments (manual/external payments only)
#
PAYMENT_PROVIDER=stripe

# =============================================================================
# APPLICATION URL (REQUIRED)
# =============================================================================
# Your application's public URL - required for webhook signature verification
# Important: Use your actual domain in production (no trailing slash)
#
# Development: http://localhost:3000
# Production:  https://yoursite.com
#
NEXT_PUBLIC_APP_URL=https://yoursite.com

# =============================================================================
# STRIPE CONFIGURATION
# =============================================================================
# Use Stripe for payment processing
# Get your keys: https://dashboard.stripe.com/apikeys
#
# ⚠️  SECURITY: Never commit your live secret key to version control!
#

# Enable Stripe (set to true when using Stripe)
STRIPE_ENABLED=true

# Stripe API Keys
# For TESTING, use keys starting with: sk_test_ and pk_test_
# For PRODUCTION, use keys starting with: sk_live_ and pk_live_
STRIPE_SECRET_KEY=sk_test_51ABC123...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51ABC123...

# Stripe Webhook Secret (REQUIRED for production)
# This verifies that webhooks actually come from Stripe
#
# Setup Instructions:
# 1. Go to: https://dashboard.stripe.com/webhooks
# 2. Click "Add endpoint"
# 3. Set URL: https://yoursite.com/api/webhooks/stripe
# 4. Select events to listen for:
#    ✓ payment_intent.succeeded
#    ✓ payment_intent.payment_failed
#    ✓ customer.subscription.updated
#    ✓ customer.subscription.deleted
#    ✓ charge.dispute.created
# 5. Copy the "Signing secret" (starts with whsec_)
#
STRIPE_WEBHOOK_SECRET=whsec_abc123...

# Stripe Environment
# test - Use test mode (test cards, no real charges)
# live - Use live mode (real cards, real charges)
STRIPE_ENVIRONMENT=test

# Test Cards for Stripe:
# Success:           4242 4242 4242 4242
# Declined:          4000 0000 0000 0002
# Insufficient funds: 4000 0000 0000 9995
# Expired card:      4000 0000 0000 0069
# Any future expiry date, any CVC

# =============================================================================
# SQUARE CONFIGURATION
# =============================================================================
# Use Square for payment processing
# Get your keys: https://developer.squareup.com/apps
#
# ⚠️  SECURITY: Never commit your production access token to version control!
#

# Enable Square (set to true when using Square)
SQUARE_INTEGRATION_ENABLED=false

# Square API Credentials
# Get from: Square Dashboard → Applications → Your App → Credentials
SQUARE_ACCESS_TOKEN=EAAAl1234...
SQUARE_LOCATION_ID=L1234ABCD...
SQUARE_APPLICATION_ID=sq0idp-1234...

# Square Webhook Signature Key (REQUIRED for production)
# This verifies that webhooks actually come from Square
#
# Setup Instructions:
# 1. Go to: https://developer.squareup.com/apps (your app)
# 2. Click "Webhooks" in left menu
# 3. Click "Add Endpoint"
# 4. Set URL: https://yoursite.com/api/webhooks/square
# 5. Subscribe to events:
#    ✓ subscription.updated
#    ✓ subscription.created
#    ✓ payment.updated
# 6. Copy the "Signature Key"
#
SQUARE_WEBHOOK_SIGNATURE_KEY=1234abcd...

# Square Environment
# sandbox    - Use sandbox mode (test transactions, no real charges)
# production - Use production mode (real transactions, real charges)
SQUARE_ENVIRONMENT=sandbox

# Test Cards for Square:
# See: https://developer.squareup.com/docs/devtools/sandbox/payments
# Square provides test cards in their sandbox dashboard

# =============================================================================
# SECURITY & RATE LIMITING
# =============================================================================
# These settings protect your payment endpoints from abuse
#

# Rate Limiting (optional, enabled by default)
# Set to 'false' to disable rate limiting (NOT recommended for production)
# RATE_LIMIT_ENABLED=true

# =============================================================================
# WEBHOOK ENDPOINTS (FOR REFERENCE)
# =============================================================================
# Configure these URLs in your payment provider's dashboard:
#
# Stripe Webhook:  https://yoursite.com/api/webhooks/stripe
# Square Webhook:  https://yoursite.com/api/webhooks/square
#
# Both endpoints are secured with signature verification
# =============================================================================

# =============================================================================
# IMPORTANT NOTES
# =============================================================================
# ✅ Only ONE payment provider can be active at a time
# ✅ Use TEST keys during development
# ✅ Use LIVE keys only in production
# ✅ Webhook secrets are REQUIRED for production
# ✅ Keep your secret keys secure - never commit to git
# ✅ The NEXT_PUBLIC_ prefix makes keys visible to the browser (safe for public keys only)
# ✅ Test your setup with test cards before going live
# 
# Security Features Enabled:
# - Webhook signature verification (prevents fake webhooks)
# - Rate limiting (5 requests per 15 minutes)
# - Idempotency keys (prevents duplicate charges)
# - Amount validation ($1 - $10,000 limits)
# - User-friendly error messages (no technical details exposed)
# 
# For detailed setup instructions, see: PAYMENT_SYSTEM_SETUP.md
# For security details, see: PAYMENT_SECURITY_AUDIT.md
# =============================================================================

# =============================================================================
# EXAMPLE CONFIGURATIONS
# =============================================================================
#
# Configuration 1: Stripe in Test Mode
# -------------------------------------
# PAYMENT_PROVIDER=stripe
# STRIPE_ENABLED=true
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_ENVIRONMENT=test
# NEXT_PUBLIC_APP_URL=http://localhost:3000
#
# Configuration 2: Square in Production
# --------------------------------------
# PAYMENT_PROVIDER=square
# SQUARE_INTEGRATION_ENABLED=true
# SQUARE_ACCESS_TOKEN=EAAAl...
# SQUARE_LOCATION_ID=L...
# SQUARE_APPLICATION_ID=sq0idp-...
# SQUARE_WEBHOOK_SIGNATURE_KEY=...
# SQUARE_ENVIRONMENT=production
# NEXT_PUBLIC_APP_URL=https://yoursite.com
#
# Configuration 3: Payments Disabled
# -----------------------------------
# PAYMENT_PROVIDER=
# (or leave PAYMENT_PROVIDER commented out)
# Users will see manual payment options only (PayPal links, crypto, etc.)
#
# =============================================================================
